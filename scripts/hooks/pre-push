#!/usr/bin/env bash
# Refreshes the local graphify knowledge graph before every push.
# graphify-out/ is gitignored (ADR-0004), so nothing is committed and the push
# is never blocked: a failed refresh only prints a warning.
# Installed by `cargo xtask install-hooks`.
set -uo pipefail

# Drain git's ref list on stdin; the refresh does not depend on it.
cat >/dev/null

command -v graphify >/dev/null 2>&1 || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
graphify update . >/dev/null 2>&1 ||
  echo "pre-push: graphify update failed; run it by hand to see why" >&2
exit 0
